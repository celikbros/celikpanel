+def query(connection, statement: str, arguments: tuple = ()) -> list:
+    try:
+        return [dict(row) for row in connection.execute(statement, arguments).fetchall()]
+    except sqlite3.Error as exc:
+        return [{"error": type(exc).__name__ + ": " + str(exc)[:160]}]
