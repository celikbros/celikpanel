+    try:
+        with socket.create_connection(("127.0.0.1", 80), timeout=20) as connection:
+            connection.sendall(("GET " + path + " HTTP/1.0\r\nHost: " + host + "\r\nConnection: close\r\n\r\n").encode())
+            raw = b""
+            while len(raw) < 131072:
