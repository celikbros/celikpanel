+
+PRE_STEP, AFTER_STEP, RESTORE_STEP = ("set10-sites-before-the-update", "set10-site-files-after-the-update",
+                                      "set10-database-restore-from-before-the-migration")
+
+
+class Set10UpdateTrial(D031, s6.Set6UpdateTrial):
+    def __init__(self, cell: Any, artifacts: dict, work_root: str, local_port: int) -> None:
+        super().__init__(cell, artifacts, work_root, local_port)
+        self.s10 = {"ids": {}}
+        finalize = self.ev.finalize_upd1
+
+        def finalize10(result: dict) -> dict:
+            result["set10"] = {"cell_kind": UPDATE_KIND, "sections": {k: v for k, v in self.sections.items()
+                                                                       if k in (PRE_STEP, AFTER_STEP, RESTORE_STEP)},
+                               "state": {k: v for k, v in self.s10.items() if k != "texts"}}
+            return finalize(result)
+        self.ev.finalize_upd1 = finalize10
+
+    def upload_helpers(self) -> dict:
+        helpers = super().upload_helpers()
+        for name in (s4.rid.HELPER, s4.HELPER4, HELPER8, HELPER10):
+            if name not in helpers:
+                helpers[name] = self.lab.put_file(self.root, self.record, self.plan, self.node_name, HERE / name, name)[1]
+        return helpers
+
+    def project(self) -> str:
+        # alpha.81 cannot create a PHP site on Arch (its vhost includes a snippet Arch's nginx does not ship).
+        return "static" if self.cell.node == "arch" else "php"
+
+    def site_domains(self) -> list:
+        # R1-R3 and the cell's own seeded static site (set4's item-9 PHP site is created after this step and is read
+        # after the update only, in extra_domains)
+        return [R1, R2, R3, "upd1-owner.test"]
+
+    def extra_domains(self) -> list:
+        return [s4.UPDATE_PHP_DOMAIN] if self.additions.get("item9") else []
+
+    def step(self, name: str, function, *, needs: tuple = ()) -> str:
+        if name == "pre-state":
+            self.section(PRE_STEP, "three sites on alpha.81 (creation text, start text, owner-edited) and, in the good "
+                                   "cell, a backup of the Panel database", self.before_update, needs=("seed",))
+        verdict = super().step(name, function, needs=needs)
+        if name == "terminal":
+            self.section(AFTER_STEP, "the site files, the ledger, the start lines, the Domains list and the three new "
