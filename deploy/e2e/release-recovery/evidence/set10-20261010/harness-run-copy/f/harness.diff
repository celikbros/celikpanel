+    # -- h and i ------------------------------------------------------------------------------------------------
+
+    def h_i(self) -> None:
+        before = self.read10("h-0-before")
+        since = float(before["epoch"]) - 2
+        fired = self.panel10("h", "restart")
+        time.sleep(SETTLE)
+        after = self.read10("h-1-after-the-restart", dump=True)
+        window = self.window("h", since)
+        panel = window["by_unit"].get("celikpanel-panel.service") or []
+        nginx = window["by_unit"].get("nginx.service") or []
+        same = {d: {k: [before["sites"][d]["vhost"].get(k), after["sites"][d]["vhost"].get(k)] for k in ("sha256", "inode", "mtime_ns")}
+                for d in self.site_domains()}
+        untouched = all(v[0] == v[1] for d in same for v in same[d].values())
+        reloads = lines_after(nginx, fired.get("epoch"), "Reloaded")
+        starts = start_lines(panel)
+        n = len(self.site_domains())
+        self.judge("h", [
+            ("the Panel restarted and answers", bool(fired.get("ok")), fired),
+            ("no vhost was written (sha256, inode and mtime unchanged for every site)", untouched, same),
+            ("nginx was not reloaded (worker PIDs unchanged; no `Reloaded` line after the restart)",
+             (before.get("nginx") or {}).get("workers") == (after.get("nginx") or {}).get("workers") and not reloads,
+             {"workers": [(before.get("nginx") or {}).get("workers"), (after.get("nginx") or {}).get("workers")], "reload_lines": reloads}),
+            (f"the start line counts {n} unchanged and 0 written",
+             any(f"0 written, {n} unchanged" in l for l in starts), starts),
+            ("one line per site saying unchanged", all(any("(startup): unchanged" in l for l in site_lines(panel, d))
+                                                     for d in self.site_domains()),
+             {d: site_lines(panel, d) for d in self.site_domains()})], {"journal": window["_file"]})
+        creation = self.s10["creation"]
+        self.judge("i", [
+            ("the file written at creation is unchanged by the start (the start's text is the creation text byte for byte)",
+             all(after["sites"][d]["vhost"].get("sha256") == creation[d]["sha256"]
+                 and after["sites"][d]["vhost"].get("inode") == creation[d]["inode"] for d in (DOMAIN_A, DOMAIN_B)),
+             {d: {"creation": creation[d], "after_the_restart": {k: after["sites"][d]["vhost"].get(k) for k in ("sha256", "inode")}}
+              for d in (DOMAIN_A, DOMAIN_B)}),
+            ("A's server_name as created names the www. alias (the start's text)",
+             f"server_name {DOMAIN_A} www.{DOMAIN_A};" in (after["sites"][DOMAIN_A]["vhost"].get("text") or ""),
+             [l.strip() for l in (after["sites"][DOMAIN_A]["vhost"].get("text") or "").splitlines() if "server_name" in l])])
+        refs = self.s10["ref"]
+        for d in self.site_domains():
+            v = after["sites"][d]["vhost"]
+            refs[d].update(text=v.get("text"), sha256=v.get("sha256"), uid=v.get("uid"), gid=v.get("gid"), mode=v.get("mode"))
+
+    # -- a, b, c, d ---------------------------------------------------------------------------------------------
+
+    def run_case(self, run: str, scenario: str, action: str, trigger: str, stopped: bool) -> dict:
+        ids = self.ids()
+        record = {"run": run, "scenario": scenario, "owner_action": action, "trigger": trigger,
+                  "panel_stopped_while_the_owner_edits": stopped, "started_at": base.utc_now()}
+        self.restore10(run)
+        pre = self.read10(f"{run}-0-restored")
+        since = float(pre["epoch"]) - 2
+        record["pending_before_the_run"] = {k: pre["sites"][DOMAIN_A]["side_files"]["pending"].get(k) for k in ("exists", "sha256")}
+        if stopped:
+            record["panel_stop"] = self.panel10(run, "stop")
+        edit = self.owner10(f"{run}-edit", "owner-vhost10", domain=DOMAIN_A, action=action, reload=True)
+        edited = self.read10(f"{run}-1-edited")
+        path, wanted = OWNER_PATHS[action]
+        http_edited = self.http10(f"{run}-1-edited", DOMAIN_A, path)
+        if not stopped:
+            time.sleep(RUNNING_EDIT_WAIT)
+        trigger_epoch = self.guest_epoch()
+        if trigger == "save":
+            fired = self.general_save10(run, ids[DOMAIN_A])
+            fired["ok"] = fired["status"] is not None
+        else:
+            fired = self.panel10(run, trigger)
+        time.sleep(SETTLE)
+        after = self.read10(f"{run}-2-after", dump=True)
+        http_after = self.http10(f"{run}-2-after", DOMAIN_A, path)
+        window = self.window(run, since)
+        shown = self.site_config(f"{run} after", ids[DOMAIN_A])
+        rows = self.domains_rows(f"{run} after")
+        record.update(self.judge_kept(run, action, trigger, edit, edited, after, http_edited, http_after, wanted, fired,
+                                      window, shown, rows, trigger_epoch))
+        record["finished_at"] = base.utc_now()
+        return record
+
+    def judge_kept(self, run, action, trigger, edit, edited, after, http_edited, http_after, wanted, fired, window,
+                   shown, rows, trigger_epoch) -> dict:
+        state = KEPT_STATE[action]
+        e_v, a_v = edited["sites"][DOMAIN_A], after["sites"][DOMAIN_A]
+        ref = self.s10["ref"][DOMAIN_A]
+        panel = window["by_unit"].get("celikpanel-panel.service") or []
+        nginx = window["by_unit"].get("nginx.service") or []
+        lines = site_lines(panel, DOMAIN_A)
+        word = "startup" if trigger in ("start", "restart") else "change"
+        pending = a_v["side_files"]["pending"]
+        body = shown["body"]
+        reloads = lines_after(nginx, trigger_epoch, "Reloaded")
+        others = {d: [edited["sites"][d]["vhost"].get("inode"), after["sites"][d]["vhost"].get("inode")]
+                  for d in (DOMAIN_B, STATIC)}
+        served_edited = wanted in str(http_edited.get("body") or "")
+        served_after = wanted in str(http_after.get("body") or "")
+        checks = [
+            ("the owner's change was in service before the trigger (nginx -t passed, reloaded, served)",
+             (edit.get("nginx_test") or {}).get("returncode") == 0 and served_edited,
+             {"nginx_test": (edit.get("nginx_test") or {}).get("returncode"), "served": served_edited}),
+            ("the trigger ran" + (" (Panel active and answering)" if trigger != "save" else " (the save was answered)"),
+             bool(fired.get("ok")), {k: v for k, v in fired.items() if k != "file"}),
+            ("the file is kept byte for byte (same SHA-256, same inode)",
+             a_v["vhost"].get("sha256") == e_v["vhost"].get("sha256") and a_v["vhost"].get("inode") == e_v["vhost"].get("inode"),
+             {"edited": {k: e_v["vhost"].get(k) for k in ("sha256", "inode")}, "after": {k: a_v["vhost"].get(k) for k in ("sha256", "inode")}}),
+            ("<file>.celikpanel-pending holds the Panel's text (equal to the Panel's own file of this site)",
+             bool(pending.get("exists")) and pending.get("sha256") == ref["sha256"],
+             {"pending": {k: pending.get(k) for k in ("path", "exists", "sha256")}, "panel_text_sha256": ref["sha256"]}),
+            (f"a journal line names the site and says {kept_word(state)}",
+             any(f"({word}): {kept_word(state)}" in l for l in lines), lines),
+            (f"GET site-config answers state {state} with a difference and the three choices",
+             shown["status"] == 200 and body.get("state") == state and bool(body.get("diff"))
+             and body.get("actions") == ["keep", "take", "merge"],
+             {k: body.get(k) for k in ("state", "actions", "pending_path", "file_sha256", "render_sha256", "include_dir", "enabled")}
+             | {"status": shown["status"], "diff_lines": len((body.get("diff") or "").splitlines())}),
+            (f"the Domains list row says {state}", (rows.get(DOMAIN_A) or {}).get("state") == state, rows.get(DOMAIN_A)),
+            ("nginx was not reloaded after the trigger (worker PIDs unchanged, no `Reloaded` line)",
+             (edited.get("nginx") or {}).get("workers") == (after.get("nginx") or {}).get("workers") and not reloads,
+             {"workers": [(edited.get("nginx") or {}).get("workers"), (after.get("nginx") or {}).get("workers")],
+              "reload_lines": reloads}),
+            ("the owner's content is still served after the trigger", served_after,
+             {"status": http_after.get("status"), "body": str(http_after.get("body") or "")[:120]}),
+            ("the other two sites' files were not touched (inode)", all(v[0] == v[1] for v in others.values()), others)]
+        if trigger == "save":
+            checks.append(("the save answers 409 SITE_CONFIG_OWNER_EDITED", fired.get("status") == 409
+                           and fired.get("code") == "SITE_CONFIG_OWNER_EDITED",
+                           {k: fired.get(k) for k in ("status", "code", "reason", "error")}))
+        verdict = self.judge(run, checks, {"files": {"edited": edited["_kept"][DOMAIN_A], "after": after["_kept"][DOMAIN_A]},
+                                           "journal": window["_file"]})
+        return {"verdict": verdict, "state": body.get("state"), "files": after["_kept"][DOMAIN_A],
+                "journal": window["_file"], "panel_lines": lines, "start_lines": start_lines(panel),
+                "trigger": {k: v for k, v in fired.items() if k != "file"}}
+
+    def scenario10(self, key: str) -> None:
+        self.current["runs"] = []
+        for spec in [r for r in RUNS if r[1] == key]:
+            try:
+                self.current["runs"].append(self.run_case(*spec))
+            except Exception as exc:  # noqa: BLE001 - one run's harness error never hides the other runs
+                self.current["runs"].append({"run": spec[0], "error": self.error_text(exc)})
+                self.check(f"{spec[0]}: the run completed", None, self.error_text(exc))
+                self.recover10(spec[0])
+
+    def error_text(self, exc: Exception) -> str:
+        error = self.redactor.text(f"{type(exc).__name__}: {exc}")[:1200]
+        stderr = getattr(exc, "stderr", None)
+        if stderr:
+            error += " | guest stderr: " + (stderr if isinstance(stderr, str) else stderr.decode("utf-8", "replace"))[-600:]
+        return error
+
+    def recover10(self, label: str) -> None:
+        """Lab recovery after a harness error inside a run: the Panel unit started again if it is not active."""
+        try:
+            state = self.snap10(f"{label}-lab-panel-state", "read-site10", domains=[DOMAIN_A])
+            if (state["units"].get("celikpanel-panel.service") or {}).get("ActiveState") != "active":
+                self.snap10(f"{label}-lab-panel-start", "owner-panel", action="start", wait=150)
+                self.current.setdefault("lab_preparation", []).append({"label": label, "what": "Panel unit started again"})
+            self.wait_api()
+        except Exception as exc:  # noqa: BLE001
+            self.current.setdefault("lab_preparation", []).append({"label": label, "recovery_error": type(exc).__name__})
+
