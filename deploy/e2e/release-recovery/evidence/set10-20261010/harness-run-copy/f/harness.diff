+# -- pure rules (covered offline by test_set10_trial) ---------------------------------------------------------------
+
+def journal_epoch(line: str) -> float | None:
+    """The time of one ``journalctl -o short-iso-precise`` line."""
+    try:
+        return datetime.fromisoformat(line.split()[0]).timestamp()
+    except (ValueError, IndexError):
+        return None
+
+
+def lines_after(lines: list, epoch: float | None, needle: str) -> list:
+    return [l for l in lines or [] if needle in l and (epoch is None or (journal_epoch(l) or 0) >= epoch)]
+
+
+def site_lines(lines: list, domain: str) -> list:
+    return [l for l in lines or [] if f"site configuration {domain} " in l]
+
+
+def start_lines(lines: list) -> list:
+    return [l for l in lines or [] if "site configuration files at start:" in l
+            or "certificate startup reconcile: restored" in l or "restore hosted vhost batch" in l]
+
+
+def kept_word(state: str) -> str:
+    return "kept (" + state.replace("_", "-") + ")"
+
+
+def verdict_of(checks: list) -> str:
+    """PASS when every expectation was measured and held; FAIL when one was measured and did not hold;
+    NOT-MEASURED when none failed and one could not be measured."""
+    if any(c[1] is False for c in checks):
+        return "FAIL"
+    if any(c[1] is None for c in checks):
+        return "NOT-MEASURED"
+    return "PASS"
+
+
+def b64(text: str | bytes) -> str:
+    return base64.b64encode(text.encode() if isinstance(text, str) else text).decode()
+
+
+def safe_name(label: str) -> str:
+    """An evidence file name from a label (the evidence writer refuses spaces and other characters)."""
+    return re.sub(r"[^A-Za-z0-9._-]+", "-", label).strip("-") or "x"
+
+
+def body_of(sealed: str | None) -> str | None:
+    if not sealed or "\n" not in sealed:
+        return None
+    return sealed.split("\n", 1)[1]
+
+
+class D031:
+    """Readers, owner actions and API calls shared by both cell kinds."""
+
+    wait_api = s8.Set8Trial.wait_api
+
+    def native10(self, mode: str, **arguments: Any) -> dict:
+        payload = base64.b64encode(json.dumps(arguments).encode()).decode()
+        return self.helper(HELPER10, mode, "--args-b64", payload, timeout=420)
+
+    def snap10(self, label: str, mode: str, **arguments: Any) -> dict:
+        value = self.native10(mode, **arguments)
+        dump = value.pop("nginx_dump", None)
+        if isinstance(dump, dict):
+            name = f"nginx-T/{dump['sha256'][:16]}.txt"
+            seen = self.state.setdefault("set10_dumps", {})
+            if dump["sha256"] not in seen:
+                seen[dump["sha256"]] = self.ev.write_text(name, dump.pop("text") or "")
+            dump.pop("text", None)
+            dump["file"] = name
+            value["nginx_dump"] = dump
+        self.native_sequence += 1
+        name = f"native/{self.native_sequence:03d}-{safe_name(label)}.json"
+        self.record_json(name, value)
+        self.current.setdefault("natives", []).append({"label": label, "mode": mode, "file": name,
+                                                       "owner_action": mode.startswith("owner-")})
+        value["_file"] = f"{self.step_dir}/{name}"
+        return value
+
+    def owner10(self, label: str, mode: str, **arguments: Any) -> dict:
+        value = self.snap10("owner-" + label, mode, **arguments)
+        self.current.setdefault("owner_actions", []).append({"label": label, "mode": mode, "at": value.get("at")})
+        return value
+
+    def keep10(self, label: str, record: dict | None) -> str | None:
+        if not isinstance(record, dict) or not record.get("exists") or record.get("text") is None:
+            return None
+        name = f"files/{safe_name(label)}.txt"
+        self.keep_text(name, record["text"])
+        return f"{self.step_dir}/{name}"
+
+    def read10(self, label: str, domains: list | None = None, dump: bool = False) -> dict:
+        domains = domains or self.site_domains()
+        value = self.snap10(f"{label}-read", "read-site10", domains=domains, dump=dump)
+        kept = {}
+        for domain in domains:
+            site = value["sites"][domain]
+            files = {"vhost": self.keep10(f"{label}-{domain}.conf", site["vhost"]),
+                     "pending": self.keep10(f"{label}-{domain}.conf.celikpanel-pending", site["side_files"]["pending"])}
+            for index, backup in enumerate(site["side_files"]["backups"]):
+                files[f"backup-{index}"] = self.keep10(f"{label}-{domain}.conf.backup-{index}", backup)
+            if site.get("symlink_target"):
+                files["symlink_target"] = self.keep10(f"{label}-{domain}-symlink-target.conf", site["symlink_target"])
+            kept[domain] = files
+        value["_kept"] = kept
+        return value
+
+    def site_domains(self) -> list:
+        return [DOMAIN_A, DOMAIN_B, STATIC]
+
+    def panel10(self, label: str, action: str) -> dict:
+        """The owner stops, starts or restarts the Panel's unit (after a start: waits for the start line)."""
+        acted = self.owner10(f"{label}-panel-{action}", "owner-panel", action=action, wait=150)
+        out = {"kind": f"owner: systemctl {action} celikpanel-panel", "file": acted["_file"],
+               "is_active": acted.get("is_active"), "epoch": acted.get("epoch"),
+               "reconcile_lines_seen": acted.get("reconcile_lines_seen"), "waited_seconds": acted.get("waited_seconds")}
+        if action != "stop":
+            out["api"] = self.wait_api()
+            out["ok"] = acted.get("is_active") == "active" and out["api"]["answering"]
+            out["session"] = self.ensure_session()
+        return out
+
+    def ensure_session(self) -> dict:
+        """The owner's session still answers /api/v1/auth/me; otherwise the owner signs in again (a database put back
+        from a backup can hold an older session table)."""
+        try:
+            me = self.api("GET", "/api/v1/auth/me", purpose="set10: is the owner's session accepted", timeout=30)
+            if me.status == 401 and getattr(self, "_password", None):
+                self.panel_client().login(self.state["username"], self._password)
+                return {"status": 401, "signed_in_again": True}
+            return {"status": me.status}
+        except Exception as exc:  # noqa: BLE001 - recorded; the next call shows what the Panel answers
+            return {"error": type(exc).__name__}
+
+    def guest_epoch(self) -> float:
+        return float(self.snap10("guest-clock", "read-ledger")["epoch"])
+
+    def window(self, label: str, since: float) -> dict:
+        return self.snap10(f"{label}-journal", "read-window", since_epoch=int(since))
+
+    def http10(self, label: str, domain: str, path: str) -> dict:
+        return self.snap10(f"http-{label}-{domain}{path.replace('/', '_')}", "read-http", domain=domain, path=path)
+
+    def site_config(self, label: str, domain_id: int) -> dict:
+        entry = self.call(f"{label}: GET site-config", "GET", f"/api/v1/domains/{domain_id}/site-config", timeout=120)
+        body = entry["_parsed"] if isinstance(entry["_parsed"], dict) else {}
+        if body.get("diff"):
+            self.keep_text(f"files/{safe_name(label)}-site-config-diff.txt", body["diff"])
+        return {"status": entry["status"], "body": body}
+
+    def domains_rows(self, label: str) -> dict:
+        entry = self.call(f"{label}: GET /api/v1/domains (Domains list)", "GET", "/api/v1/domains", timeout=120)
+        rows = entry["_parsed"] if isinstance(entry["_parsed"], list) else []
+        return {r.get("domain_name"): r.get("site_config") for r in rows if isinstance(r, dict)}
+
+    def post_raw(self, label: str, path: str, body: Any, identity: str | None) -> dict:
+        """A POST sent as a page sends it: with ``identity`` as X-CelikPanel-Request-Id, or without one (a page that
+        was loaded before the update)."""
+        started = time.time()
+        response = self.bare_post(path, body, identity, timeout=420)
+        parsed = response.json()
+        entry = {"label": label, "at": base.utc_now(), "request": {"method": "POST", "path": path, "body": body,
+                                                                 "x_celikpanel_request_id": identity},
+                 "status": response.status, "json": self.redactor.value(parsed) if parsed is not None else None,
+                 "text": None if parsed is not None else self.redactor.text(response.text[:600]),
+                 "seconds": round(time.time() - started, 2)}
+        self.current.setdefault("calls", []).append(entry)
+        return {"status": response.status, "body": parsed if isinstance(parsed, dict) else {}, "entry": entry}
+
+    def general_save10(self, label: str, domain_id: int) -> dict:
+        shown = self.call(f"{label}: General settings read", "GET", f"/api/v1/domains/{domain_id}/general")
+        body = shown["_parsed"] if isinstance(shown["_parsed"], dict) else {}
+        sent = {"document_root": body.get("document_root"), "web_server": body.get("web_server") or "nginx",
+                "redirect_www": bool(body.get("redirect_www"))}
+        saved = self.call(f"{label}: General settings saved unchanged (renders the vhost)", "POST",
+                          f"/api/v1/domains/{domain_id}/general", sent, timeout=300)
+        parsed = saved["_parsed"] if isinstance(saved["_parsed"], dict) else {}
+        return {"read_status": shown["status"], "sent": sent, "status": saved["status"], "code": parsed.get("code"),
+                "reason": parsed.get("reason"), "error": parsed.get("error")}
+
+    @staticmethod
+    def brief(site: dict) -> dict:
+        v, l = site.get("vhost") or {}, site.get("enabled") or {}
+        return {"vhost": {k: v.get(k) for k in ("exists", "kind", "sha256", "size", "inode", "mode", "owner", "group",
+                                                 "uid", "gid", "lsattr", "immutable", "mtime_ns", "ctime_ns", "link_target",
+                                                 "header", "first_line")},
+                "enabled": {k: l.get(k) for k in ("exists", "kind", "link_target", "inode")},
+                "pending": {k: (site.get("side_files") or {}).get("pending", {}).get(k) for k in ("exists", "sha256", "mode")},
+                "backups": [{k: b.get(k) for k in ("path", "sha256", "mode", "owner", "group", "uid", "gid")}
+                            for b in (site.get("side_files") or {}).get("backups") or []],
+                "include_dir": {k: (site.get("include_dir") or {}).get(k) for k in ("exists", "kind", "mode_octal", "uid", "gid", "owner", "group")}
+                | {"entries": [e.get("path") for e in (site.get("include_dir") or {}).get("entries") or []]}}
+
+    @staticmethod
+    def ledger_row(reading: dict, domain_id: int | None) -> dict | None:
+        rows = ((reading.get("ledger") or {}).get("managed_site_files") or [])
+        return next((r for r in rows if r.get("domain_id") == domain_id), None)
+
+    def judge(self, name: str, checks: list, detail: Any = None) -> str:
+        """One cell's D-031 verdict from its expectations; every expectation is also a check of the section."""
+        for text, ok, data in checks:
+            self.check(f"{name}: {text}", ok, data)
+        verdict = verdict_of(checks)
+        self.current.setdefault("cells", {})[name] = {"verdict": verdict, "expectations": [
+            {"expectation": text, "held": ok, "measured": data} for text, ok, data in checks], "detail": detail}
+        self.note(f"{name}: {verdict}", [text for text, ok, _ in checks if ok is not True])
+        return verdict
+
+
+class Set10Trial(D031, s8.Set8Trial):
+    def upload_helpers(self) -> dict:
+        helpers = super().upload_helpers()
+        helpers[HELPER10] = self.lab.put_file(self.root, self.record, self.plan, self.node_name, HERE / HELPER10, HELPER10)[1]
+        return helpers
+
+    # -- state of this cell -------------------------------------------------------------------------------------
+
+    @property
+    def s10(self) -> dict:
+        return self.state.setdefault("set10", {})
+
+    def ids(self) -> dict:
+        return self.s10.setdefault("ids", {})
+
+    def restore10(self, label: str, domain: str = DOMAIN_A) -> dict:
+        """Lab preparation: the site's vhost back to the Panel's text recorded after S0's restart (set8's restore)."""
+        ref = self.s10["ref"][domain]
+        value = self.snap10(f"{label}-lab-restore-{domain}", "lab-restore", domain=domain, content_b64=b64(ref["text"]),
+                            uid=ref["uid"], gid=ref["gid"], file_mode=ref["mode"])
+        self.current.setdefault("lab_preparation", []).append({"label": label, "domain": domain, "file": value["_file"],
+                                                              "sha256_matches": value.get("sha256_matches")})
+        return value
+
+    # -- S0 -----------------------------------------------------------------------------------------------------
+
+    def create_php(self, domain: str) -> int:
+        created = self.call(f"create PHP site {domain}", "POST", "/api/v1/domains/create",
+                            {"domain": domain, "project_type": "php", "ssl_type": "none"}, timeout=600)
+        answer = created["_parsed"] if isinstance(created["_parsed"], dict) else {}
+        domain_id = answer.get("DomainID") or answer.get("domain_id")
+        self.check(f"the PHP site {domain} is created through the Panel (200 with its id)",
+                   created["status"] == 200 and isinstance(domain_id, int), created.get("answer") or answer)
+        if not isinstance(domain_id, int):
+            raise base.StepFailed(f"{domain} was not created")
+        self.owner8(f"files-{domain}", "owner-files", domain_id=domain_id)
+        self.ids()[domain] = domain_id
+        return domain_id
+
+    def s0_sites(self) -> None:
+        platform = self.snap4("platform", "read-platform")
+        self.current["platform"] = {k: platform.get(k) for k in ("os_release", "kernel", "packages", "nginx_version",
+                                                                  "php_fpm_programs")}
+        self.ids()[STATIC] = self.state.get("domain_id")
+        for domain in (DOMAIN_A, DOMAIN_B):
+            self.create_php(domain)
+        reading = self.read10("s0-after-creation", dump=True)
+        text_dump = Path(self.ev.directory, reading["nginx_dump"]["file"]).read_text() if reading.get("nginx_dump") else ""
+        refs, cells = {}, []
+        for domain in self.site_domains():
+            site = reading["sites"][domain]
+            vhost = site["vhost"]
+            head = vhost.get("header") or {}
+            row = self.ledger_row(reading, self.ids().get(domain))
+            directory = site["include_dir"]
+            include_line = f"include {INCLUDE_BASE}/{domain}/*.conf;"
+            refs[domain] = {"text": vhost.get("text"), "sha256": vhost.get("sha256"), "uid": vhost.get("uid"),
+                            "gid": vhost.get("gid"), "mode": vhost.get("mode"), "inode": vhost.get("inode"),
+                            "mtime_ns": vhost.get("mtime_ns")}
+            cells += [(f"{domain}: the first line is the render header and its digest is the body's digest",
+                       bool(head.get("present") and head.get("valid")), {"header": head, "first_line": vhost.get("first_line")}),
+                      (f"{domain}: one ledger row, state managed_unchanged, body digest = the header's, file digest = the file's",
+                       bool(row) and row.get("state") == "managed_unchanged" and row.get("body_sha256") == head.get("declared")
+                       and row.get("file_sha256") == vhost.get("sha256"), row),
+                      (f"{domain}: the include directory exists, is empty and 0755",
+                       directory.get("kind") == "directory" and directory.get("entries") == [] and directory.get("mode_octal") == "0o755",
+                       {k: directory.get(k) for k in ("path", "kind", "mode_octal", "uid", "gid", "entries")}),
+                      (f"{domain}: the vhost includes the site's include directory and nginx -T shows it",
+                       include_line in (vhost.get("text") or "") and include_line in text_dump, include_line)]
+        cells.append(("`nginx -t` passes", (reading.get("nginx_test") or {}).get("returncode") == 0, reading.get("nginx_test")))
+        self.s10["ref"] = refs
+        self.s10["creation"] = {d: {k: refs[d][k] for k in ("sha256", "inode", "mtime_ns")} for d in refs}
+        page = {d: s4.parse_probe(self.http10("s0", d, PROBE_PATH)) for d in (DOMAIN_A, DOMAIN_B)}
+        cells.append(("both PHP sites execute their probe page", all(p["executed"] for p in page.values()), page))
+        self.current["ledger"] = reading.get("ledger")
+        self.current["sites"] = {d: self.brief(reading["sites"][d]) for d in self.site_domains()}
