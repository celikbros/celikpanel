+out["boot_id"] = open("/proc/sys/kernel/random/boot_id").read().strip()
+out["uptime_seconds"] = float(open("/proc/uptime").read().split()[0])
+out["at"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
+print(json.dumps(out, sort_keys=True))
+'''
