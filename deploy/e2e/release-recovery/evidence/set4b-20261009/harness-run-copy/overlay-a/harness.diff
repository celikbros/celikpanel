+    match = re.search(r"location\s+~\s+\\\.php\$\s*\{(.*?)\n\s*\}", text, re.S)
+    if not match:
+        return []
+    return [line.strip() for line in match.group(1).splitlines() if line.strip() and not line.strip().startswith("#")]
