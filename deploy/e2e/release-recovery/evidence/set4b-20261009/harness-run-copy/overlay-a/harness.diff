+        elif record["status"] == 502:
+            self.judge_refused("long-site-name", record)
+        else:
+            self.note("item 6 (long-site-name): the request was answered neither 200 nor 502; recorded as it is",
+                      {k: record[k] for k in ("status", "code", "reason", "error")})
