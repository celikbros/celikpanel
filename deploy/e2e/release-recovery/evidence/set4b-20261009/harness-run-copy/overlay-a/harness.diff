+# ---------------------------------------------------------------------------
+# Pure rules
+# ---------------------------------------------------------------------------
+
+def pinned_snippet_sha256(source: Path = PINNED_SOURCE) -> str | None:
+    """The digest the product's test pins for the Debian 13 package's snippet (read from this run copy's source)."""
+    try:
+        found = re.search(r'debianFastCGIPHPSnippetSHA256\s*=\s*"([0-9a-f]{64})"', source.read_text())
+    except OSError:
+        return None
+    return found.group(1) if found else None
+
+
+def parse_probe(reading: dict | None) -> dict:
+    """What the probe page printed: its first line (marker, 6*7, PHP version, server API, account) and the request
+    values PHP-FPM was handed. ``executed`` only when the marker, 42 and no source text are there."""
+    body = str((reading or {}).get("body") or "")
+    lines = body.splitlines()
+    parts = lines[0].split(":") if lines else []
+    values = {}
+    for line in lines[1:]:
+        found = re.fullmatch(r"([A-Z_]+)=\[(.*)\]", line)
+        if found:
+            values[found.group(1)] = found.group(2)
+    executed = (reading or {}).get("status") == 200 and len(parts) >= 5 and parts[0] == PROBE_MARK and parts[1] == "42" \
+        and "<?php" not in body
+    return {"executed": bool(executed), "php_version": parts[2] if executed else None, "server_api": parts[3] if executed else None,
+            "runs_as": parts[4] if executed else None, "values": values if executed else {}}
+
+
+def major_minor(version: Any) -> str | None:
+    found = re.search(r"(\d+)\.(\d+)", str(version or ""))
+    return f"{found.group(1)}.{found.group(2)}" if found else None
+
+
+def brief_reading(reading: dict | None) -> dict:
+    reading = reading or {}
+    return {"status": reading.get("status"), "bytes": reading.get("bytes"), "body_sha256": reading.get("body_sha256"),
+            "headers": reading.get("headers"), "error": reading.get("error"), "body": str(reading.get("body") or "")[:700]}
+
+
+def same_answers(before: dict, after: dict) -> dict:
+    """Per request: the status and the body digest of two readings, and whether both are equal."""
+    out = {}
+    for name, _path in REQUESTS:
+        a, b = before.get(name) or {}, after.get(name) or {}
+        out[name] = {"status": [a.get("status"), b.get("status")], "body_sha256": [a.get("body_sha256"), b.get("body_sha256")],
+                     "equal": a.get("status") is not None and a.get("status") == b.get("status")
+                     and a.get("body_sha256") == b.get("body_sha256")}
+    return out
+
+
+def refused_sentence(reason: str, domain: str) -> str | None:
+    if reason == "removed":
+        return "The site " + domain + " was not created: " + REFUSED_WHAT + REFUSED_REMOVED + REFUSED_OWNER + REFUSED_END
+    if reason == "cleanup_unconfirmed":
+        return ("The site " + domain + " was not created: " + REFUSED_WHAT + REFUSED_UNCONFIRMED.replace("{domain}", domain)
+                + REFUSED_OWNER + REFUSED_END)
+    return None
+
+
+def vhost_of(nginx: dict) -> dict | None:
+    files = [f for f in (nginx or {}).get("files") or [] if f.get("kind") == "file" and f.get("php_location_lines")]
+    return files[0] if files else None
+
