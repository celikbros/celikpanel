+        parsed = answer["_parsed"] if isinstance(answer["_parsed"], dict) else {}
+        after = self.snap4(f"{key}-leftovers-after", "read-leftovers", domain=domain)
+        nginx_after = self.snap4(f"{key}-nginx-unit-after", "read-units", units=["nginx.service"], since_epoch=int(t0))
+        listed = [d.get("domain_name") for d in self.domains_listed() or []]
+        panel_b, panel_a = before.get("panel") or {}, after.get("panel") or {}
+        new_site_dirs = sorted(set(after.get("site_directories") or []) - set(before.get("site_directories") or []))
+        new_acme_dirs = sorted(set(after.get("acme_challenge_directories") or []) - set(before.get("acme_challenge_directories") or []))
+        new_sockets = sorted({s.get("path") for s in after.get("sockets") or []} - {s.get("path") for s in before.get("sockets") or []})
