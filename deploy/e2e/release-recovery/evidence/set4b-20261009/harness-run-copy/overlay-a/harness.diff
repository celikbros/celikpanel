+    def m6_site_refused(self) -> None:
+        # Reading A: the owner, tidying /etc/nginx by hand, renamed nginx's own fastcgi.conf. The configuration in
+        # service does not read that file, so `nginx -t` still passes; the vhost of a new PHP site names it.
+        moved = None
+        try:
+            moved = self.owner4("nginx-fastcgi-conf-moved-away", "owner-nginx-file", action="move-away")
+            passes = (moved["after"]["nginx_test"] or {}).get("returncode") == 0
+            self.current["owner_moved_fastcgi_conf"] = {"path": moved.get("path"), "moved_to": moved.get("moved_to"),
+                                                        "nginx_test_before": moved["before"]["nginx_test"],
+                                                        "nginx_test_after_the_move": moved["after"]["nginx_test"]}
+            self.check("item 6 (owner-moved-file): after the owner moved /etc/nginx/fastcgi.conf away, `nginx -t` still passes "
+                       "(the refusal can only come with a new vhost)", passes, self.current["owner_moved_fastcgi_conf"])
+            if passes:
+                record = self.refused_reading("owner-moved-file", REFUSED_DOMAIN,
+                                              "the owner renamed nginx's own /etc/nginx/fastcgi.conf, which the generated PHP vhost includes")
+                self.judge_refused("owner-moved-file", record)
+        finally:
+            if moved is not None:
+                restored = self.owner4("nginx-fastcgi-conf-restored", "owner-nginx-file", action="restore")
+                self.check("item 6 (owner-moved-file): the owner put the file back and `nginx -t` passes",
+                           (restored["after"]["nginx_test"] or {}).get("returncode") == 0, restored["after"])
+        again = self.call("M6 (owner-moved-file) create the same site again after the owner's correction", "POST",
+                          "/api/v1/domains/create", {"domain": REFUSED_DOMAIN, "project_type": "php", "ssl_type": "none"}, timeout=600)
+        body = again["_parsed"] if isinstance(again["_parsed"], dict) else {}
+        again_id = body.get("DomainID") or body.get("domain_id")
+        self.check("item 6 (owner-moved-file): after the correction the same site is created (200), as the sentence says",
+                   again["status"] == 200 and isinstance(again_id, int), again.get("answer") or body)
+        if isinstance(again_id, int):
+            with_site = self.snap4("refused-again-leftovers-with-site", "read-leftovers", domain=REFUSED_DOMAIN)
+            self.delete_site("refused-again", REFUSED_DOMAIN, again_id, None, with_site)
+        # Reading B: no owner action at all; a long site name. Whether nginx refuses it is the observation.
+        record = self.refused_reading("long-site-name", LONG_DOMAIN,
+                                      f"no owner action; the site name has {len(LONG_DOMAIN)} characters")
+        if record["status"] == 200:
