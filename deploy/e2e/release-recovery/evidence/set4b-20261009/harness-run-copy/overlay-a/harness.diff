+class Set4UpdateTrial(Native4, base.Trial):
+    def upload_helpers(self) -> dict:
+        helpers = super().upload_helpers()
+        for name in (rid.HELPER, HELPER4):
+            helpers[name] = self.lab.put_file(self.root, self.record, self.plan, self.node_name, HERE / name, name)[1]
+        return helpers
+
+    def keep4(self, label: str, mode: str, **arguments: Any) -> dict:
+        value = self.native4(mode, **arguments)
+        self.state["set4_n"] = self.state.get("set4_n", 0) + 1
+        self.record_json(f"native/{self.state['set4_n']:03d}-{label}.json", value)
+        return value
+
+    def step(self, name: str, function, *, needs: tuple = ()) -> str:
+        # The two added steps: after the seed and before the pre-update state is taken; and before the collection.
+        if name == "pre-state" and self.cell.variant == "good":
+            super().step("set4-php-site-before-the-update", self.php_before, needs=("seed",))
+        if name == "collect":
+            if self.cell.variant == "good":
+                super().step("set4-php-site-after-the-update", self.php_after, needs=("terminal", "set4-php-site-before-the-update"))
+            elif self.cell.variant in base.ROLLBACK_VARIANTS:
+                super().step("set4-update-check-after-the-return", self.update_check_after_return, needs=("terminal",))
+        return super().step(name, function, needs=needs)
+
+    def reading(self, domain: str, when: str) -> dict:
+        answers = self.ask(domain, lambda name, mode, **arguments: self.keep4(f"http-{when}-{name}", mode, **arguments))
+        nginx = self.keep4(f"nginx-{when}", "read-nginx", domain=domain)
+        vhost = vhost_of(nginx) or {}
+        self.ev.write_text(f"{self.step_dir}/native-text/vhost-{when}.conf.txt", vhost.get("text") or "(no vhost file names the domain)")
+        return {"answers": answers, "nginx_test": nginx.get("nginx_test"),
+                "vhost": {k: vhost.get(k) for k in ("path", "sha256", "bytes", "inode", "mtime_ns", "ctime_ns", "includes",
+                                                    "names_the_php_snippet", "fastcgi_pass", "php_location_lines")},
+                "nginx_unit": {k: (nginx.get("unit") or {}).get(k) for k in ("ActiveState", "MainPID", "InvocationID")}}
+
+    def php_before(self, checks: dict) -> str:
+        """Item 9, before the update: the installed baseline creates a PHP site; its vhost names the snippet."""
+        domain = UPDATE_PHP_DOMAIN
+        version = self.api("GET", "/api/v1/panel/version", purpose="version before the PHP site is created")
+        checks["panel_version"] = version.json()
+        platform = self.keep4("platform", "read-platform")
+        snippet = platform.get("nginx_php_snippet") or {}
+        checks["platform"] = {k: platform.get(k) for k in ("os_release", "packages", "nginx_version", "php_fpm_programs")}
+        checks["nginx_php_snippet"] = {"sha256": snippet.get("sha256"), "exists": snippet.get("exists"),
+                                       "pinned_in_the_product_test": pinned_snippet_sha256(),
+                                       "owner_package": snippet.get("owner_package")}
+        response = self.api("POST", "/api/v1/domains/create", {"domain": domain, "project_type": "php", "ssl_type": "none"},
+                            purpose="set4: a PHP site created by the installed baseline", timeout=600)
+        body = response.json() or {}
+        domain_id = body.get("DomainID") or body.get("domain_id")
+        checks["create"] = {"http": response.status, "body": body}
+        if response.status != 200 or not isinstance(domain_id, int):
+            raise base.StepFailed(f"the baseline did not create the PHP site: HTTP {response.status}")
+        probe = self.keep4("owner-php-probe", "owner-php-probe", domain_id=domain_id)
+        reading = self.reading(domain, "before-the-update")
+        page = parse_probe(reading["answers"]["probe"])
+        record = self.keep4("leftovers-before-the-update", "read-leftovers", domain=domain)
+        site = ((record.get("panel") or {}).get("sites") or [{}])[0]
+        self.state["set4_php"] = {"domain": domain, "domain_id": domain_id, "before": reading, "site_account": probe.get("site_account")}
+        checks.update(domain=domain, domain_id=domain_id, owner_action="the owner uploaded set4-probe.php and set4-static.txt",
+                      site_account=probe.get("site_account"), probe=page, vhost=reading["vhost"], nginx_test=reading["nginx_test"],
+                      recorded={"php_version": site.get("php_version"), "php_fpm_socket": site.get("php_fpm_socket")},
+                      answers={name: brief_reading(value) for name, value in reading["answers"].items()})
+        failures = []
+        if not page["executed"] or page["runs_as"] != probe.get("site_account"):
+            failures.append("the PHP page was not executed as the site's account before the update")
+        if reading["vhost"].get("names_the_php_snippet") is not True:
+            failures.append("the baseline's vhost does not name snippets/fastcgi-php.conf (the precondition of item 9)")
+        if (reading["nginx_test"] or {}).get("returncode") != 0:
+            failures.append("`nginx -t` does not pass before the update")
+        if failures:
+            raise base.StepFailed("; ".join(failures))
+        return "passed"
