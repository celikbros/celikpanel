+    def php_after(self, checks: dict) -> str:
+        """Item 9, after the verified update: the same requests; one Panel action that renders the vhost again (the
+        site's General settings saved with the values the Panel shows); the same requests once more."""
+        seen = self.state["set4_php"]
+        domain, domain_id, before = seen["domain"], seen["domain_id"], seen["before"]
+        version = self.api("GET", "/api/v1/panel/version", purpose="version after the update")
+        checks["panel_version"] = version.json()
+        untouched = self.reading(domain, "after-the-update-before-the-save")
+        general = self.api("GET", f"/api/v1/domains/{domain_id}/general", purpose="DomainGeneralSettings read")
+        shown = general.json() if general.status == 200 else {}
+        sent = {"document_root": (shown or {}).get("document_root"), "web_server": (shown or {}).get("web_server") or "nginx",
+                "redirect_www": bool((shown or {}).get("redirect_www"))}
+        clock = self.keep4("nginx-unit-before-the-save", "read-units", units=["nginx.service"])
+        since = calendar.timegm(time.strptime(clock["at"], "%Y-%m-%dT%H:%M:%SZ"))     # the guest's own clock
+        time.sleep(1.5)
+        saved = self.api("POST", f"/api/v1/domains/{domain_id}/general", sent, purpose="DomainGeneralSettings save (renders the vhost again)",
+                         timeout=300)
+        time.sleep(1.5)
