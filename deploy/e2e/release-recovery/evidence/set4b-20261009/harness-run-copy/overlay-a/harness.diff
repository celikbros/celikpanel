+class Native4:
+    """The set4 guest helper, for both trial kinds."""
+
+    def native4(self, mode: str, **arguments: Any) -> dict:
+        payload = base64.b64encode(json.dumps(arguments).encode()).decode()
+        return self.helper(HELPER4, mode, "--args-b64", payload, timeout=300)
+
+    def ask(self, domain: str, keep) -> dict:
+        """The fixed set of requests to this guest's own web server with the site's Host header."""
+        answers = {}
+        for name, path in REQUESTS:
+            answers[name] = keep(name.replace("_", "-"), "read-http", domain=domain, path=path)
+        return answers
+
+    def texts(self, keys, values: dict | None = None) -> dict:
+        english = self.translator.catalog["en"]
+        return {key: {language: self.translator.text(key, dict(values or {}), language=language) for language in ("en", "tr")}
+                for key in keys if key in english}
+
+
