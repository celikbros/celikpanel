+    def m4_reload_stopped(self) -> None:
+        for service in ("nginx", "mariadb", "postgresql"):
+            units = [u for u in self.service_units()[service]]
+            first = self.snap4(f"{service}-units-at-start", "read-units", units=units)
+            loaded = [u for u in units if (first["units"].get(u) or {}).get("LoadState") == "loaded"]
+            stopped = self.service_action(service, "stop", "set4, before the reload")
+            how = "the Panel's Stop"
+            if stopped["daemon_after"]["running"]:
+                real = stopped["daemon_after"]["real_unit"] or loaded[-1]
+                self.owner(f"{service}-owner-stop", "owner-systemctl", action="stop", unit=real)
+                how = f"`systemctl stop {real}` by the owner on the server (the Panel's Stop left it running)"
+            time.sleep(2)
+            t0 = self.guest_clock()
+            time.sleep(1.2)
+            before = self.snap4(f"{service}-stopped-before-reload", "read-units", units=loaded)
+            answer = self.service_action(service, "reload", "while stopped", sw.NOT_RUNNING)
+            time.sleep(2)
+            after = self.snap4(f"{service}-after-refused-reload", "read-units", units=loaded, since_epoch=int(t0))
+            same = {u: {k: [before["units"][u].get(k), after["units"][u].get(k)] for k in (
+                        "ActiveState", "SubState", "InvocationID", "StateChangeTimestamp", "ActiveEnterTimestamp",
+                        "InactiveEnterTimestamp", "ExecMainStartTimestamp", "ExecReload", "NRestarts", "MainPID")} for u in loaded}
+            unchanged = all(pair[0] == pair[1] for unit in same.values() for pair in unit.values())
+            journal = after.get("journal") or {}
+            record = {"service": service, "stopped_by": how, "units": loaded, "since": after.get("since_epoch"),
+                      "answer": {k: answer.get(k) for k in ("status", "code", "reason", "vars", "answer")},
+                      "state_before": before.get("is_active"), "state_after": after.get("is_active"),
+                      "unit_properties_before_and_after": same, "unit_properties_unchanged": unchanged,
+                      "journal_of_the_units_since": journal, "journal_of_systemd_about_them_since": after.get("journal_systemd_manager"),
+                      "journal_of_the_product_since": after.get("journal_product")}
+            self.current.setdefault("reloads", {})[service] = record
+            self.keep_text(f"journal/{service}-since-the-refused-reload.txt", "\n".join(
+                [f"##### {u} (journalctl -u {u} --since @{after.get('since_epoch')})\n" + ("\n".join(journal.get(u) or []) or "(no lines)")
+                 for u in loaded] + ["##### systemd (PID 1) lines naming the unit\n" + ("\n".join(after.get("journal_systemd_manager") or []) or "(no lines)"),
+                                     "##### celikpanel-agent.service and celikpanel-panel.service\n" + ("\n".join(after.get("journal_product") or []) or "(no lines)")]))
+            self.check(f"item 4 ({service}): the unit was stopped before the reload was asked",
+                       not answer["daemon_before"]["running"] and all(v in ("inactive", "failed") for v in (before.get("is_active") or {}).values()),
+                       {"stopped_by": how, "is_active": before.get("is_active"), "daemon": answer["daemon_before"]["running"]})
+            self.check(f"item 4 ({service}): the journal shows nothing was sent to the unit: no line of the unit and no line of "
