+        return value
+
+    def requests(self, domain: str, when: str) -> dict:
+        return self.ask(domain, lambda name, mode, **arguments: self.snap4(f"http-{when}-{name}", mode, **arguments))
+
+    def domains_listed(self) -> list | None:
+        listing = self.api("GET", "/api/v1/domains", purpose="Domains list")
