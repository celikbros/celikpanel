+                       and all(v in ("inactive", "failed") for v in (after.get("is_active") or {}).values()), record)
+            started = self.service_action(service, "start", "after the refused reload")
+            self.check(f"item 4 ({service}): Start brings the service back afterwards", started["daemon_after"]["running"],
