+    def judge_refused(self, key: str, record: dict) -> None:
+        self.check(f"item 6 ({key}): the answer is 502 SITE_WEB_SERVER_REFUSED with a reason",
+                   record["status"] == 502 and record["code"] == "SITE_WEB_SERVER_REFUSED"
+                   and record["reason"] in ("removed", "cleanup_unconfirmed"),
+                   {k: record[k] for k in ("status", "code", "reason", "vars", "details")})
+        self.check(f"item 6 ({key}): `vars` are the domain and `sudo nginx -t`, `details` is one line of nginx's own, and the "
+                   "sentence is the documented one for the reason",
+                   (record["vars"] or {}).get("domain") == record["domain"] and (record["vars"] or {}).get("command") == "sudo nginx -t"
+                   and isinstance(record["details"], list) and len(record["details"]) == 1 and record["error_equals_the_documented_sentence"],
+                   {k: record[k] for k in ("vars", "details", "error", "error_equals_the_documented_sentence")})
+        claims = record["what_the_removed_answer_claims_and_whether_it_is_true"]
+        if record["reason"] == "removed":
+            self.check(f"item 6 ({key}): what the answer says was removed is gone on the guest (vhost, system account, files, "
+                       "PHP pool) and no domain or site row is left; it claims no more than is true",
+                       all(claims.values()), {"claims": claims, "native": record["native"]})
+        elif record["reason"] == "cleanup_unconfirmed":
+            self.check(f"item 6 ({key}): the answer does not claim a removal (cleanup_unconfirmed); what is left is recorded",
+                       True, {"left": {name: not gone for name, gone in claims.items()}, "native": record["native"]})
+        unit = record["native"]["nginx_unit"]
+        self.check(f"item 6 ({key}): nginx still runs as the same process after the refusal (reloaded, not restarted) and "
+                   "`nginx -t` passes", unit["ActiveState"] == ["active", "active"] and unit["MainPID"][0] == unit["MainPID"][1]
+                   and (record["native"]["nginx_test_after"] or {}).get("returncode") == 0,
+                   {"nginx_unit": unit, "nginx_test_after": record["native"]["nginx_test_after"]})
+        self.note(f"item 6 ({key}): the certificate-validation directory the Agent prepared for the refused site "
+                  + ("is left on the server; the answer does not mention it" if record["not_claimed_by_the_answer"]["the certificate-validation directory"]
+                     else "is not on the server"), record["not_claimed_by_the_answer"])
