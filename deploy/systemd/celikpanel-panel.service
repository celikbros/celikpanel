[Unit]
# CelikPanel web panel. Runs as the unprivileged celikpanel user; it holds
# no root and talks to the agent only over the authenticated socket.
# CelikPanel web paneli. Yetkisiz celikpanel kullanıcısı olarak çalışır;
# hiç root tutmaz ve agent ile yalnızca kimlik-doğrulamalı socket üzerinden
# konuşur.
Description=CelikPanel web panel
After=celikpanel-agent.service network.target
Requires=celikpanel-agent.service

[Service]
Type=simple
User=celikpanel
Group=celikpanel
WorkingDirectory=/opt/celikpanel

# /var/lib/celikpanel (SQLite database + DKIM is under /etc), owned
# celikpanel:celikpanel by systemd.
# /var/lib/celikpanel (SQLite veritabanı), systemd tarafından
# celikpanel:celikpanel sahipliğiyle.
StateDirectory=celikpanel
StateDirectoryMode=0750

Environment=CELIKPANEL_DATA_DIR=/var/lib/celikpanel
Environment=CELIKPANEL_WEB_DIR=/opt/celikpanel/web
Environment=CELIKPANEL_LISTEN=:1983
Environment=CELIKPANEL_AGENT_SOCKET=/run/celikpanel/agent.sock
Environment=CELIKPANEL_AGENT_TOKEN_FILE=/etc/celikpanel/agent.token
# HTTPS: a normal install adds CELIKPANEL_TLS=1 here (self-signed cert, so
# the panel never serves credentials over plain HTTP). To use a real
# certificate — e.g. the panel hostname's Let's Encrypt files — set instead:
#   Environment=CELIKPANEL_TLS_CERT=/etc/letsencrypt/live/<host>/fullchain.pem
#   Environment=CELIKPANEL_TLS_KEY=/etc/letsencrypt/live/<host>/privkey.pem
# HTTPS: normal kurulum buraya CELIKPANEL_TLS=1 ekler (kendinden-imzalı; panel
# kimlik bilgilerini düz HTTP'de sunmaz). Gerçek sertifika için yukarıdaki
# CELIKPANEL_TLS_CERT / CELIKPANEL_TLS_KEY satırlarını kullanın.

ExecStart=/opt/celikpanel/bin/panel
Restart=on-failure
RestartSec=3

# Hardening: the panel has no business gaining privileges or writing outside
# its state directory.
# Sertleştirme: panelin yetki kazanmaya ya da durum dizini dışına yazmaya
# işi yok.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/celikpanel

[Install]
WantedBy=multi-user.target
