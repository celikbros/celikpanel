[Unit]
# CelikPanel web panel. Runs as the unprivileged celikpanel user; it holds
# no root and talks to the agent only over the authenticated socket.
# CelikPanel web paneli. Yetkisiz celikpanel kullanıcısı olarak çalışır;
# hiç root tutmaz ve agent ile yalnızca kimlik-doğrulamalı socket üzerinden
# konuşur.
Description=CelikPanel web panel
Wants=celikpanel-agent.service
After=celikpanel-agent.service network.target
# Retry without a hard stop, but see RestartSteps below: parking this unit in
# failed state would leave the operator with no interface at all, and there is
# no off-panel recovery surface yet. The brake is the backoff, not a cap.
# Sert durdurma olmadan yeniden dene; ama aşağıdaki RestartSteps'e bak: bu
# birimi "failed" durumunda park etmek operatörü hiç arayüzsüz bırakır ve
# panel dışı bir kurtarma yüzeyi henüz yok. Fren, üst sınır değil, artan bekleme.
# A limit that actually trips on EVERY supported systemd. RestartSteps and
# RestartMaxDelaySec arrived in systemd 254; older builds (RHEL 9 ships the 252
# family) load the unit and ignore them with a warning, so the backoff below
# simply does not exist there. Disabling the limiter would then leave that
# platform with an unbounded 3s flap - A17 unfixed exactly where it is hardest
# to see. 30 starts per hour is the floor: on old systemd it stops the flap
# after ~90s; on 254+ the backoff stretches those 30 attempts over hours, so it
# is a last resort rather than the brake.
# HER desteklenen systemd surumunde gercekten devreye giren bir sinir.
# RestartSteps ve RestartMaxDelaySec systemd 254 ile geldi; daha eski surumler
# (RHEL 9, 252 ailesi) birimi yukleyip bunlari uyariyla yok sayar, yani
# asagidaki artan bekleme orada hic yoktur. Sinirlayiciyi kapatmak o platformu
# sinirsiz 3sn cirpinmayla birakirdi - A17 en gorunmez oldugu yerde acik
# kalirdi. Saatte 30 baslatma taban: eski systemd'de cirpinmayi ~90 saniyede
# durdurur; 254+ uzerinde artan bekleme o 30 denemeyi saatlere yaydigi icin
# fren degil son caredir.
StartLimitIntervalSec=3600
StartLimitBurst=30

[Service]
Type=simple
User=celikpanel
Group=celikpanel
UMask=0077
WorkingDirectory=/opt/celikpanel

# /var/lib/celikpanel (SQLite database + DKIM is under /etc), owned
# celikpanel:celikpanel by systemd.
# /var/lib/celikpanel (SQLite veritabanı), systemd tarafından
# celikpanel:celikpanel sahipliğiyle.
StateDirectory=celikpanel
StateDirectoryMode=0750

Environment=CELIKPANEL_DATA_DIR=/var/lib/celikpanel
Environment=CELIKPANEL_WEB_DIR=/opt/celikpanel/web
Environment=CELIKPANEL_LISTEN=:2083
Environment=CELIKPANEL_AGENT_SOCKET=/run/celikpanel/agent.sock
Environment=CELIKPANEL_AGENT_TOKEN_FILE=/etc/celikpanel/agent.token
Environment=CELIKPANEL_TLS=1
Environment=CELIKPANEL_PANEL_INSECURE_COOKIES_FLAG=
Environment=CELIKPANEL_PANEL_DEMO_FLAG=
EnvironmentFile=-/etc/celikpanel/panel.env
# HTTPS is the vendor default. Durable operator overrides belong in the
# root-only /etc/celikpanel/panel.env; install and update preserve that file.
# A real certificate can be selected there with CELIKPANEL_TLS_CERT and
# CELIKPANEL_TLS_KEY. Demo flags are likewise read only from that file.
# HTTPS üretici varsayılanıdır. Kalıcı operatör geçersiz kılmaları root-only
# /etc/celikpanel/panel.env içine yazılır; kurulum ve güncelleme onu korur.

ExecStart=/opt/celikpanel/bin/panel $CELIKPANEL_PANEL_INSECURE_COOKIES_FLAG $CELIKPANEL_PANEL_DEMO_FLAG
Restart=on-failure
RestartSec=3
# A fixed 3s retry never stops. systemd's default limiter is 5 starts per 10s,
# and a ~3.5s crash cycle admits at most 4 — permanently one under the
# threshold — so a boot-time failure flaps until someone notices. Escalate
# 3s -> 120s instead: a transient host fault still self-heals in seconds, while
# a persistent one costs ~30 attempts an hour rather than ~1200.
# Sabit 3sn'lik yeniden deneme hiç durmaz. systemd'nin varsayılan freni 10
# saniyede 5 başlatmadır ve ~3,5sn'lik bir çökme döngüsüne en fazla 4 tanesi
# sığar — eşiğin kalıcı olarak bir altı — yani açılış hatası biri fark edene
# kadar çırpınır. Bunun yerine 3sn -> 120sn artır: geçici bir arıza yine
# saniyeler içinde toparlanır, kalıcı olan ise saatte ~1200 yerine ~30 denemeye
# mal olur.
RestartSteps=6
RestartMaxDelaySec=120
KillMode=control-group
SendSIGKILL=yes
TimeoutStopSec=30s

# Hardening: the panel has no business gaining privileges or writing outside
# its state directory.
# Sertleştirme: panelin yetki kazanmaya ya da durum dizini dışına yazmaya
# işi yok.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/celikpanel

[Install]
WantedBy=multi-user.target
