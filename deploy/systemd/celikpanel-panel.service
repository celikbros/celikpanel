[Unit]
# CelikPanel web panel. Runs as the unprivileged celikpanel user; it holds
# no root and talks to the agent only over the authenticated socket.
# CelikPanel web paneli. Yetkisiz celikpanel kullanıcısı olarak çalışır;
# hiç root tutmaz ve agent ile yalnızca kimlik-doğrulamalı socket üzerinden
# konuşur.
Description=CelikPanel web panel
Wants=celikpanel-agent.service
After=celikpanel-agent.service network.target

[Service]
Type=simple
User=celikpanel
Group=celikpanel
UMask=0077
WorkingDirectory=/opt/celikpanel

# /var/lib/celikpanel (SQLite database + DKIM is under /etc), owned
# celikpanel:celikpanel by systemd.
# /var/lib/celikpanel (SQLite veritabanı), systemd tarafından
# celikpanel:celikpanel sahipliğiyle.
StateDirectory=celikpanel
StateDirectoryMode=0750

Environment=CELIKPANEL_DATA_DIR=/var/lib/celikpanel
Environment=CELIKPANEL_WEB_DIR=/opt/celikpanel/web
Environment=CELIKPANEL_LISTEN=:2083
Environment=CELIKPANEL_AGENT_SOCKET=/run/celikpanel/agent.sock
Environment=CELIKPANEL_AGENT_TOKEN_FILE=/etc/celikpanel/agent.token
Environment=CELIKPANEL_TLS=1
Environment=CELIKPANEL_PANEL_INSECURE_COOKIES_FLAG=
Environment=CELIKPANEL_PANEL_DEMO_FLAG=
EnvironmentFile=-/etc/celikpanel/panel.env
# HTTPS is the vendor default. Durable operator overrides belong in the
# root-only /etc/celikpanel/panel.env; install and update preserve that file.
# A real certificate can be selected there with CELIKPANEL_TLS_CERT and
# CELIKPANEL_TLS_KEY. Demo flags are likewise read only from that file.
# HTTPS üretici varsayılanıdır. Kalıcı operatör geçersiz kılmaları root-only
# /etc/celikpanel/panel.env içine yazılır; kurulum ve güncelleme onu korur.

ExecStart=/opt/celikpanel/bin/panel $CELIKPANEL_PANEL_INSECURE_COOKIES_FLAG $CELIKPANEL_PANEL_DEMO_FLAG
Restart=on-failure
RestartSec=3
KillMode=control-group
SendSIGKILL=yes
TimeoutStopSec=30s

# Hardening: the panel has no business gaining privileges or writing outside
# its state directory.
# Sertleştirme: panelin yetki kazanmaya ya da durum dizini dışına yazmaya
# işi yok.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/celikpanel

[Install]
WantedBy=multi-user.target
