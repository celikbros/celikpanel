Options -Indexes

AddType application/json .json
AddType text/plain .txt .sha256
AddType application/gzip .gz

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "no-referrer"
  Header always set Permissions-Policy "camera=(), geolocation=(), microphone=()"
  Header always set Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"

  <FilesMatch "^(latest\.(json|txt)|index\.json)$">
    Header always set Cache-Control "no-store, max-age=0"
  </FilesMatch>

  <FilesMatch "\.(tar\.gz|sha256)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # The page and its stylesheet keep their names across releases, so without
  # this a returning visitor can pair a new page with the stylesheet it was not
  # written for - which is exactly how the previous design was seen on top of
  # the current one. They must be revalidated on every visit; the typefaces
  # never change under their names, so they may be cached hard.
  #
  # Sayfa ve stil dosyasi surumler boyunca ayni adi tasir; bu satirlar olmadan
  # geri donen bir ziyaretci yeni sayfayi eski stille gorebilir. Her ziyarette
  # dogrulanmalidirlar; yazi tipleri adlari altinda hic degismedigi icin uzun
  # sure onbelleklenebilir.
  <FilesMatch "\.(html|css|js)$">
    Header always set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(woff2|svg)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
