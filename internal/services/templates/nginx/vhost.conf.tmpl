# Nginx vhost for {{.Domain}}
# Generated by CelikPanel — do not edit by hand / elle düzenlemeyin
# Site ID: {{.SiteID}} · Project type: {{.ProjectType}}

{{- define "locations"}}
{{- if eq .ProjectType "php"}}
    root {{.DocumentRoot}};
    index index.php index.html index.htm;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:{{.PHPSocket}};
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;
    }

    {{- /* Dotfiles are denied EXCEPT .well-known. Blocking only /\.ht (the
        old rule) left .env and .git readable over HTTP — on a PHP site that
        is the framework's database password, APP_KEY and mail credentials in
        plain text (Laravel/Symfony and most modern PHP apps keep .env in the
        project root). The .well-known exception is not cosmetic: site
        certificates are issued with `certbot --webroot`, which serves the
        challenge from .well-known/acme-challenge — a blanket dotfile deny
        turns every issuance and renewal into a 403.
        Nokta dosyaları .well-known DIŞINDA reddedilir. Yalnız /\.ht engellemek
        (eski kural) .env ve .git'i HTTP'ye açık bırakıyordu — bir PHP sitesinde
        bu, framework'ün veritabanı parolası, APP_KEY'i ve posta bilgileri demek
        (Laravel/Symfony ve çoğu modern PHP uygulaması .env'i proje kökünde
        tutar). .well-known istisnası süs değil: site sertifikaları
        `certbot --webroot` ile alınır ve doğrulama .well-known/acme-challenge
        üzerinden sunulur — battaniye ret her alma ve yenilemeyi 403 yapar. */}}
    location ~ /\.(?!well-known).* {
        deny all;
    }
{{- else if eq .ProjectType "static"}}
    root {{.DocumentRoot}};
    index index.html index.htm;

    location / {
        try_files $uri $uri/ =404;
    }

    {{- /* Same rule as the PHP branch: the previous blanket /\. deny also
        blocked .well-known/acme-challenge, so a static site could not pass
        webroot validation — its first certificate and every renewal 403'd.
        The golden path was proven with a PHP site, which is why this stayed
        invisible.
        PHP dalıyla aynı kural: önceki battaniye /\. reddi
        .well-known/acme-challenge'ı da kapatıyordu; statik site webroot
        doğrulamasını geçemiyordu — ilk sertifikası ve her yenilemesi 403.
        Golden path PHP sitesiyle kanıtlandığı için bu görünmez kalmıştı. */}}
    location ~ /\.(?!well-known).* {
        deny all;
    }
{{- else}}
    # Reverse proxy to the application / Uygulamaya ters vekil
    location / {
        proxy_pass {{.Upstream}};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 60s;
    }
{{- end}}
{{- end}}

{{- if eq .ProjectType "forwarding"}}
server {
    listen 80;
    listen [::]:80;
    server_name {{.Domain}}{{if .TempDomain}} {{.TempDomain}}{{end}};

    access_log /var/log/nginx/{{.Domain}}-access.log;
    return {{.ForwardCode}} {{.ForwardTo}}$request_uri;
}
{{- else if eq .SSLType "none"}}
server {
    listen 80;
    listen [::]:80;
    server_name {{.Domain}}{{if .TempDomain}} {{.TempDomain}}{{end}};

    access_log /var/log/nginx/{{.Domain}}-access.log;
    error_log /var/log/nginx/{{.Domain}}-error.log;
{{template "locations" .}}
}
{{- else}}
# HTTP server (redirect to HTTPS)
server {
    listen 80;
    listen [::]:80;
    server_name {{.Domain}}{{if .TempDomain}} {{.TempDomain}}{{end}};
    return 301 https://$host$request_uri;
}

# HTTPS server
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{.Domain}}{{if .TempDomain}} {{.TempDomain}}{{end}};

    ssl_certificate {{.SSLCert}};
    ssl_certificate_key {{.SSLKey}};

    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    access_log /var/log/nginx/{{.Domain}}-access.log;
    error_log /var/log/nginx/{{.Domain}}-error.log;
{{template "locations" .}}
}
{{- end}}
