# Nginx vhost for {{.Domain}}
# Generated by CelikPanel — do not edit by hand / elle düzenlemeyin
# Site ID: {{.SiteID}} · Project type: {{.ProjectType}}

{{- define "locations"}}
{{- if eq .ProjectType "php"}}
    root {{.DocumentRoot}};
    index index.php index.html index.htm;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:{{.PHPSocket}};
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;
    }

    location ~ /\.ht {
        deny all;
    }
{{- else if eq .ProjectType "static"}}
    root {{.DocumentRoot}};
    index index.html index.htm;

    location / {
        try_files $uri $uri/ =404;
    }

    location ~ /\. {
        deny all;
    }
{{- else}}
    # Reverse proxy to the application / Uygulamaya ters vekil
    location / {
        proxy_pass {{.Upstream}};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 60s;
    }
{{- end}}
{{- end}}

{{- if eq .ProjectType "forwarding"}}
server {
    listen 80;
    listen [::]:80;
    server_name {{.Domain}}{{if .TempDomain}} {{.TempDomain}}{{end}};

    access_log /var/log/nginx/{{.Domain}}-access.log;
    return {{.ForwardCode}} {{.ForwardTo}}$request_uri;
}
{{- else if eq .SSLType "none"}}
server {
    listen 80;
    listen [::]:80;
    server_name {{.Domain}}{{if .TempDomain}} {{.TempDomain}}{{end}};

    access_log /var/log/nginx/{{.Domain}}-access.log;
    error_log /var/log/nginx/{{.Domain}}-error.log;
{{template "locations" .}}
}
{{- else}}
# HTTP server (redirect to HTTPS)
server {
    listen 80;
    listen [::]:80;
    server_name {{.Domain}}{{if .TempDomain}} {{.TempDomain}}{{end}};
    return 301 https://$host$request_uri;
}

# HTTPS server
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{.Domain}}{{if .TempDomain}} {{.TempDomain}}{{end}};

    ssl_certificate {{.SSLCert}};
    ssl_certificate_key {{.SSLKey}};

    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    access_log /var/log/nginx/{{.Domain}}-access.log;
    error_log /var/log/nginx/{{.Domain}}-error.log;
{{template "locations" .}}
}
{{- end}}
